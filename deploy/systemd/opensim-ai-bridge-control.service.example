[Unit]
Description=OpenSim AI Bridge local administration controller
After=network.target
# Separate from the avatar bot: management remains available while avatar is offline.

[Service]
Type=simple
User=root
Group=www-data
RuntimeDirectory=opensim-ai-bridge-control
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 /usr/local/libexec/opensim-ai-bridge/control.py --install-dir @INSTALL_DIR@
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=@INSTALL_DIR@ /run/opensim-ai-bridge-control
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
