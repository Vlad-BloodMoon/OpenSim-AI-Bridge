{
  "Grid": {
    "LoginUri": "https://YOUR-GRID-LOGIN-URL",
    "AvatarFirstName": "AI",
    "AvatarLastName": "Resident",
    "AvatarPasswordEnv": "OSAI_AVATAR_PASSWORD",
    "StartLocation": {
      "Mode": "Region",
      "RegionName": "TestRegion",
      "Position": {
        "X": 128,
        "Y": 128,
        "Z": 25
      }
    }
  },
  "Bot": {
    "EnableLocalChat": true,
    "EnableIM": true,
    "ReconnectEnabled": true
  },
  "Ai": {
    "Enabled": false,
    "Provider": "Groq",
    "Model": "openai/gpt-oss-20b",
    "ApiKeyEnv": "OSAI_AI_API_KEY",
    "AuthorizedUuidList": [],
    "PublicAccess": false,
    "MaxRequestsPerHour": 30,
    "MinSecondsBetweenRequests": 15,
    "SystemPrompt": "Tu es un assistant OpenSimulator. Réponds dans la langue du résident et n'invente pas d'informations sur la grille."
  }
}
