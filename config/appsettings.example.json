{
  "Grid": {
    "LoginUri": "https://YOUR-GRID-LOGIN-URL",
    "AvatarFirstName": "AI",
    "AvatarLastName": "Resident",
    "AvatarPasswordEnv": "OSAI_AVATAR_PASSWORD",
    "HomeRegion": "Welcome",
    "HomePosition": {
      "X": 128,
      "Y": 128,
      "Z": 25
    }
  },
  "Bot": {
    "EnableLocalChat": true,
    "EnableIM": true,
    "ReconnectEnabled": true
  },
  "Web": {
    "BindAddress": "127.0.0.1",
    "Port": 5050
  },
  "Ai": {
    "Enabled": false,
    "Provider": "OpenAI",
    "ApiKeyEnv": "OPENAI_API_KEY",
    "AuthorizedUuidList": [],
    "MonthlyApplicationBudgetEUR": 5
  },
  "Translation": {
    "Enabled": false,
    "Provider": "ConfigurableHttp",
    "Endpoint": "https://YOUR-TRANSLATOR-ENDPOINT",
    "ApiKeyEnv": "TRANSLATOR_API_KEY"
  },
  "GridIntegration": {
    "Enabled": false,
    "Mode": "ReadOnly",
    "ConnectionStringEnv": "OSAI_GRID_READONLY_CONNECTION"
  },
  "Storage": {
    "Provider": "SQLite",
    "FilePath": "data/opensim-ai-bridge.sqlite"
  }
}
