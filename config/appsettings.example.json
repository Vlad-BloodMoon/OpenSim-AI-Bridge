{
  "Grid": {
    "LoginUri": "https://YOUR-GRID-LOGIN-URL",
    "AvatarFirstName": "AI",
    "AvatarLastName": "Resident",
    "AvatarPasswordEnv": "OSAI_AVATAR_PASSWORD",
    "StartLocation": {
      "Mode": "Region",
      "RegionName": "BloodMoon_TEST",
      "Position": {
        "X": 128,
        "Y": 128,
        "Z": 25
      }
    },
    "FallbackToHome": true
  },
  "Bot": {
    "EnableLocalChat": true,
    "EnableIM": true,
    "ReconnectEnabled": true
  },
  "Web": {
    "BindAddress": "127.0.0.1",
    "Port": 5050
  },
  "Ai": {
    "Enabled": false,
    "Provider": "OpenAI",
    "Model": "gpt-4.1-mini",
    "ApiKeyEnv": "OSAI_AI_API_KEY",
    "AuthorizedUuidList": [],
    "PublicAccess": false,
    "MaxRequestsPerHour": 30,
    "MinSecondsBetweenRequests": 15,
    "SystemPrompt": "Tu es un assistant BloodMoon. Réponds dans la langue du message et n’invente pas d’informations sur la grille."
  },
  "Translation": {
    "Enabled": false,
    "Provider": "ConfigurableHttp",
    "Endpoint": "https://YOUR-TRANSLATOR-ENDPOINT",
    "ApiKeyEnv": "TRANSLATOR_API_KEY"
  },
  "GridIntegration": {
    "Enabled": false,
    "Mode": "ReadOnly",
    "ConnectionStringEnv": "OSAI_GRID_READONLY_CONNECTION"
  },
  "Storage": {
    "Provider": "SQLite",
    "FilePath": "data/opensim-ai-bridge.sqlite"
  }
}
