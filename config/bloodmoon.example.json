{
  "Grid": {
    "LoginUri": "http://YOUR-GRID-DOMAIN:8002/",
    "AvatarFirstName": "BloodMoon",
    "AvatarLastName": "AI",
    "AvatarPasswordEnv": "OSAI_AVATAR_PASSWORD",
    "StartLocation": {
      "Mode": "Region",
      "RegionName": "YOUR_TEST_REGION",
      "Position": {
        "X": 128,
        "Y": 128,
        "Z": 25
      }
    }
  },
  "Bot": {
    "EnableLocalChat": true,
    "EnableIM": true,
    "ReconnectEnabled": true
  },
  "Ai": {
    "Enabled": false,
    "Provider": "Groq",
    "Model": "openai/gpt-oss-20b",
    "ApiKeyEnv": "OSAI_AI_API_KEY",
    "AuthorizedUuidList": [],
    "PublicAccess": false,
    "MaxRequestsPerHour": 30,
    "MinSecondsBetweenRequests": 15,
    "SystemPrompt": "Tu es un assistant de la grille. Réponds dans la langue du résident sans inventer de faits."
  }
}
